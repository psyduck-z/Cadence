
  # Node.js dependencies
  node_modules/

  # Electron build output and installers
  dist/
  out/
  release/

  # Local Cadence user data
  data/

  # Codex workspace metadata
  .agents/
  .codex/

  # Environment variables and secrets
  .env
  .env.*
  !.env.example

  # Code-signing certificates and private keys
  *.pfx
  *.p12
  *.pem
  *.key
  *.cer
  *.crt

  # Logs
  *.log
  logs/
  npm-debug.log*
  yarn-debug.log*
  yarn-error.log*
  pnpm-debug.log*

  # Test and code coverage output
  coverage/
  .nyc_output/

  # Build and tool caches
  .cache/
  .parcel-cache/
  .eslintcache
  *.tsbuildinfo

  # Temporary files
  *.tmp
  *.temp
  *.bak
  *.swp
  *~

  # Editor settings
  .vscode/
  .idea/

  # Windows system files
  Thumbs.db
  Thumbs.db:encryptable
  ehthumbs.db
  Desktop.ini
  $RECYCLE.BIN/

  # macOS system files
  .DS_Store
  .AppleDouble
  .LSOverride
  ._*

  # Linux desktop files
  .directory
  .Trash-*